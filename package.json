{
  "name": "hcs-cli",
  "version": "0.2.0",
  "description": "Holographic Context Standard: verifiable, fidelity-scored context files for any LLM.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hcs": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "SPEC.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check:self": "node dist/src/cli.js check project.hcs",
    "conformance": "npm run build && node conformance/run.mjs"
  },
  "keywords": [
    "llm",
    "context",
    "agents",
    "documentation",
    "drift",
    "evaluation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Oufrid/HCS.git"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
